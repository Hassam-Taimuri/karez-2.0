# ============================================================
# Karez 2.0 — environment variables
# Copy to .env.local for local development. NEVER commit .env.local.
# ============================================================

# --- Required ---
# Google Gemini API key (default AI provider).
# In AI Studio deployments this is injected via the Secrets panel.
GEMINI_API_KEY="your-gemini-api-key-here"

# --- Optional: provider configuration ---
# Comma-separated Gemini model priority list (defaults shown).
# GEMINI_MODELS="gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-pro-preview,gemini-flash-latest"

# Provider order. Qwen is only tried if DASHSCOPE_API_KEY is set.
# PROVIDER_ORDER="gemini,qwen"

# Alibaba Cloud DashScope (Qwen) — optional fallback provider.
# DASHSCOPE_API_KEY=""
# DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# QWEN_VISION_MODELS="qwen-vl-max,qwen-vl-plus"
# QWEN_TEXT_MODELS="qwen-max,qwen-plus"

# --- Optional: analysis limits ---
# Maximum rendered pages sent per analysis when a PDF is too large to send whole.
# MAX_PAGES_PER_ANALYSIS="12"

# --- Optional: client-side ---
# Base URL for pdf.js loaded in the browser (no npm dependency).
# NEXT_PUBLIC_PDFJS_BASE="https://cdn.jsdelivr.net/npm/pdfjs-dist@4/build"

# Firebase web config overrides (public client identifiers; defaults live in
# firebase-applet-config.json which is intentionally committed).
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# --- Injected by hosting (AI Studio / Cloud Run) ---
# APP_URL="https://your-deployment-url"
